#!/usr/bin/env nu
#MISE description="Pin the foundation source clones (connectrpc, buffa, connectrpc-workers) at the tag matching their lockfile — so READ == COMPILE"
# Tag-derived: tag = v<version-in-lockfile>. connectrpc-workers is used only by
# the standalone gateway workspace, so its version comes from that lockfile.
let lockdeps = [
  { repo: "anthropics/connect-rust",    crate: "connectrpc",         lock: "Cargo.lock" }
  { repo: "anthropics/buffa",           crate: "buffa",              lock: "Cargo.lock" }
  { repo: "connyay/connectrpc-workers", crate: "connectrpc-workers", lock: "examples/rauthy-cedar/gateway/Cargo.lock" }
]
for d in $lockdeps {
  let dir = $".src/($d.repo | path basename)"
  let lock = (open $d.lock | from toml)
  let ver = ($lock.package | where name == $d.crate | get version | first)
  let want = $"v($ver)"
  if not ($dir | path exists) { print $"cloning ($d.repo)"; git clone --quiet $"https://github.com/($d.repo).git" $dir }
  git -C $dir fetch --quiet --all --tags  # all remotes: a fork origin can lack upstream's tags
  let co = (do { git -C $dir checkout --quiet $want } | complete)
  if $co.exit_code == 0 { print $"  ($d.crate) ($ver) → @ ($want) ✓" } else { print $"  ⚠️  ($d.crate): tag ($want) missing — check tag scheme" }
}
print ""
print "READ-ONLY source matching our pins."
